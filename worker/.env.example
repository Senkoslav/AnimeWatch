# Образец для worker/.env. Скопируй и заполни; worker/.env в git не попадает.
# Секреты воркера живут только в его процессе, в Next.js их не передаём.

# my.telegram.org → API development tools, под аккаунтом-воркером.
TG_API_ID=
TG_API_HASH=

# Заполняет pnpm tg:login. Сессия — полный доступ к аккаунту: не пересылать, не коммитить.
TG_SESSION=

# Архивный канал с мастерами: id из ссылки на пост t.me/c/<id>/<номер поста>.
TG_ARCHIVE_CHAT=
