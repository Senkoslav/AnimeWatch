# Образец для .env.local. Скопируй и заполни; .env.local в git не попадает.
# Всё без префикса NEXT_PUBLIC_ читается только в серверном коде.

# Postgres. На проде DATABASE_URL — через пулер (рантайм и next build: главная рендерится на сборке),
# DIRECT_URL — напрямую (миграции). Превью Vercel тоже собираются с DATABASE_URL: решить, какой базой.
# Локально обе строки указывают на одну базу.
DATABASE_URL=postgresql://USER@localhost:5432/animewatch
DIRECT_URL=postgresql://USER@localhost:5432/animewatch
# Необязательно: пустая база, в которой Prisma примеряет миграции (migrate dev / migrate diff).
# SHADOW_DATABASE_URL=postgresql://USER@localhost:5432/animewatch_shadow
# Необязательно: база для pnpm test:db. По умолчанию postgresql://<пользователь ОС>@localhost:5432/animewatch_test.
# TEST_DATABASE_URL=

# Kodik: токен выдаёт их поддержка по заявке с указанием сайта (docs/05-kodik.md).
# Без него страница просмотра показывает «источник не подключён», сайт остаётся рабочим.
KODIK_API_TOKEN=

# Уведомление об обращении правообладателя (/dmca): бот и чат, куда оно уходит.
TELEGRAM_BOT_TOKEN=
DMCA_TG_CHAT=
# Соль для хеша IP заявителя: без неё хеш обратим перебором. Любая длинная случайная строка.
DMCA_IP_SALT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
