# Образец для .env.local. Скопируй и заполни; .env.local в git не попадает.
# Всё без префикса NEXT_PUBLIC_ читается только в серверном коде.

# Postgres. На проде DATABASE_URL — через пулер (рантайм), DIRECT_URL — напрямую (миграции).
# Локально обе строки указывают на одну базу.
DATABASE_URL=postgresql://USER@localhost:5432/bebradub
DIRECT_URL=postgresql://USER@localhost:5432/bebradub

# Bunny Stream: Stream → библиотека → API.
BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Хост pull zone библиотеки, без протокола: vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_CDN_HOSTNAME=
# Ключ токен-аутентификации CDN: им подписываются playback-URL.
BUNNY_TOKEN_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
